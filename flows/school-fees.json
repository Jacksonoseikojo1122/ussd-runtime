{
  "start": "main",
  "nodes": {
    "main": {
      "prompt": "Sunrise School fees",
      "kind": "menu",
      "options": [
        { "key": "1", "label": "Pay fees", "next": "pay_student" },
        { "key": "2", "label": "Check balance", "next": "bal_student" },
        { "key": "3", "label": "Exit", "next": "bye" }
      ]
    },

    "pay_student": {
      "prompt": "Enter the student ID",
      "kind": "input",
      "input": { "name": "student_id", "type": "digits", "min_length": 4, "max_length": 8, "next": "pay_lookup",
                 "error": "Student IDs are 4 to 8 digits." }
    },
    "pay_lookup": {
      "prompt": "Pay for {{student_name}} ({{class_name}})?\nOutstanding: GHS {{balance}}",
      "kind": "menu",
      "action": { "url": "$BACKEND_URL/ussd/student", "timeout_ms": 2000, "can_go_to": ["not_found"] },
      "options": [
        { "key": "1", "label": "Yes", "next": "pay_amount" },
        { "key": "2", "label": "No", "next": "bye" }
      ]
    },
    "pay_amount": {
      "prompt": "Enter amount in GHS",
      "kind": "input",
      "input": { "name": "amount", "type": "amount", "min": "1", "max": "5000", "next": "pay_confirm" }
    },
    "pay_confirm": {
      "prompt": "Pay GHS {{amount}} for {{student_name}} from {{phone}}?",
      "kind": "menu",
      "options": [
        { "key": "1", "label": "Confirm", "next": "pay_request" },
        { "key": "2", "label": "Cancel", "next": "bye" }
      ]
    },
    "pay_request": {
      "prompt": "Request {{reference}} sent. Approve GHS {{amount}} on the prompt that follows.",
      "kind": "end",
      "action": { "url": "$BACKEND_URL/ussd/pay", "timeout_ms": 3000,
                  "error_message": "We couldn't start the payment. Nothing was charged. Please try again." }
    },

    "bal_student": {
      "prompt": "Enter the student ID",
      "kind": "input",
      "input": { "name": "student_id", "type": "digits", "min_length": 4, "max_length": 8, "next": "bal_show" }
    },
    "bal_show": {
      "prompt": "{{student_name}} ({{class_name}}) owes GHS {{balance}}.",
      "kind": "end",
      "action": { "url": "$BACKEND_URL/ussd/student", "timeout_ms": 2000, "can_go_to": ["not_found"] }
    },

    "not_found": { "prompt": "We couldn't find student {{student_id}}. Check the ID and dial again.", "kind": "end" },
    "bye": { "prompt": "Thank you.", "kind": "end" }
  }
}
